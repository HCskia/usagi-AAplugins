	"ocr_api_list":{
		"type":"template_list",
		"description":"OCR服务器API列表",
		"hint":"按先后添加顺序为调用顺序",
		"templates":{
			"ocr_api_template":{
				"name":"API地址",
				"hint":"OCR服务器所属API地址",
				"items":{
					"url":{
						"description": "OCR服务器所属API地址",
						"hint":"局域网 PaddleX 风格服务填 http://<OCR服务器IP>:8900/ocr（推荐，免Token）；PaddleOCR AI Studio 异步接口填 https://paddleocr.aistudio-app.com/api/v2/ocr/jobs",
						"type": "string"
					},
					"token":{
						"description": "API验证Token",
						"hint":"没有则不填（局域网服务通常不需要）",
						"type": "string"
					},
					"model":{
						"description": "OCR模型名称",
						"hint":"仅 PaddleOCR AI Studio 异步接口使用，默认 PP-OCRv6；局域网服务忽略此项",
						"type": "string",
						"default": "PP-OCRv6"
					}
				}
			}
		}
	},
